{
    "name": "@abhishekzambare/mui-table",
    "description": "MUI Wrapper",
    "version": "0.0.10",
    "author": "Abhishek Zambare",
    "license": "MIT",
    "private": false,
    "keywords": [
        "react",
        "mui",
        "material ui",
        "angular",
        "vue"
    ],
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/mui-table.cjs",
    "module": "./dist/mui-table.js",
    "exports": {
        ".": {
            "import": "./dist/mui-table.js",
            "require": "./dist/mui-table.cjs"
        }
    },
    "homepage": "https://abhishekzambare-mui-table.vercel.app/",
    "bugs": {
        "url": "https://github.com/Macintosh98/MUITable/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Macintosh98/MUITable.git"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check . --config ./.prettierrc.json",
        "format:fix": "prettier --write . --config ./.prettierrc.json",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@abhishekzambare/animate": "^0.0.9",
        "@abhishekzambare/mui": "^0.0.34",
        "@babel/core": "^8.0.1",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.59.0",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "motion": "^13.2.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "rolldown": "^1.2.7",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.69.0",
        "unplugin-dts": "^1.1.0",
        "vite": "^8.2.2",
        "vite-plugin-checker": "^0.14.5"
    },
    "peerDependencies": {
        "@abhishekzambare/animate": "*",
        "@abhishekzambare/mui": "*",
        "motion": "^13",
        "@emotion/react": "^11",
        "@emotion/styled": "^11",
        "@mui/icons-material": "^9",
        "@mui/material": "^9",
        "react": "^19",
        "react-dom": "^19"
    }
